@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using System.Security.Claims
@inject NavigationManager Nav

<MudThemeProvider Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <NotAuthorized>
        @* Nicht eingeloggt: sofort zur Login-Seite weiterleiten *@
        @* Dies wird sicherstellen, dass nicht authentifizierte Benutzer zur Login-Seite weitergeleitet werden *@
        <div>@Body</div>
    </NotAuthorized>

    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1" Color="Color.Primary">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Edge="Edge.Start"
                               Style="color: white;"
                               OnClick="@ToggleDrawer" />

                <MudText Typo="Typo.h6" Style="color: white;">
                    NotenPro
                </MudText>

                <MudSpacer />

                <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                               Style="color: white;" />

                <div class="d-flex align-center ml-2">
                    <MudMenu Color="Color.Inherit"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight">

                        <ActivatorContent>
                            <div class="d-flex align-center mr-1" style="cursor: pointer;">
                                <MudAvatar Color="Color.Secondary"
                                           Size="Size.Medium"
                                           Class="mr-2">
                                    @GetInitials(DisplayName)
                                </MudAvatar>

                                <MudText Typo="Typo.body2" Style="color: white;">
                                    @DisplayName
                                </MudText>
                            </div>
                        </ActivatorContent>

                        <ChildContent>
                            <MudMenuItem>
                                <div class="d-flex align-center">
                                    <MudAvatar Color="Color.Primary"
                                               Size="Size.Small"
                                               Class="mr-2">
                                        @GetInitials(DisplayName)
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body2">@DisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @UserName
                                        </MudText>
                                    </div>
                                </div>
                            </MudMenuItem>

                            <MudDivider />

                            <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                         OnClick="Logout"
                            >
                                Abmelden
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Class="ml-2"
                                   Style="color: white;"
                                   OnClick="Logout"
                    />
                </div>
            </MudAppBar>

            <MudDrawer @bind-Open="@_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
                <MudDrawerHeader>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.School"
                                 Color="Color.Primary"
                                 Size="Size.Large"
                                 Class="mr-2" />
                        <MudText Typo="Typo.h6" Color="Color.Primary">HTL Krems</MudText>
                    </div>
                </MudDrawerHeader>

                <MudNavMenu>
                    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Home</MudNavLink>
                    <MudNavLink Href="/secure" Icon="@Icons.Material.Filled.Lock">Secure</MudNavLink>
                </MudNavMenu>
            </MudDrawer>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    private string DisplayName => _displayName ?? "User";
    private string UserName => _userName ?? "";

    private string? _displayName;
    private string? _userName;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary          = "#29aae3",
            Secondary        = "#BDBDBD",
            Background       = "#FAFAFA",
            AppbarBackground = "#29aae3",
            DrawerBackground = "#ffffff",
            Success          = Colors.Green.Default,
            Warning          = Colors.Orange.Default,
            Error            = Colors.Red.Default
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // DisplayName und UserName aus den Claims extrahieren
        _displayName = user.Identity?.Name ??
                       user.FindFirst("name")?.Value ??
                       user.FindFirst(ClaimTypes.Name)?.Value;

        _userName = user.FindFirst("preferred_username")?.Value ??
                    user.FindFirst("upn")?.Value ??
                    user.FindFirst(ClaimTypes.Email)?.Value;

        // Wenn nicht authentifiziert, leite zur Login-Seite weiter
        
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name[..1].ToUpper();
    }
}
@code {
    void Logout()
    {
        Nav.NavigateToLogout("authentication/logout");
    }
}


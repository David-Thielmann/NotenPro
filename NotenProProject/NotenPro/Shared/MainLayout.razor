@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using System.Security.Claims
@using HTLKrems.GradeManagement.Services
@inject NavigationManager Nav
@inject INotificationService NotificationService

<MudThemeProvider Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <NotAuthorized>
        <div>@Body</div>
    </NotAuthorized>

    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1" Color="Color.Primary">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Edge="Edge.Start"
                               Style="color: white;"
                               OnClick="@ToggleDrawer" />

                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h6" Class="mb-n1" Style="color: white;">
                        NotenPro
                    </MudText>
                    @if (_isStudent)
                    {
                        <MudText Typo="Typo.caption" Style="color: white;">
                            Schülerportal
                        </MudText>
                    }
                    else if (_isTeacher)
                    {
                        <MudText Typo="Typo.caption" Style="color: white;">
                            Lehrerportal
                        </MudText>
                    }
                    else if (_isAdmin)
                    {
                        <MudText Typo="Typo.caption" Style="color: white;">
                            Adminportal
                        </MudText>
                    }
                </div>

                <MudSpacer />

                @if (_isStudent)
                {
                    <MudBadge Content="@_unreadCount"
                              Color="Color.Error"
                              Overlap="true"
                              Visible="@(_unreadCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                                       Style="color: white;"
                                       OnClick="@(() => Nav.NavigateTo("/student/notifications"))" />
                    </MudBadge>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                                   Style="color: white;" />
                }

                <div class="d-flex align-center ml-2">
                    <MudMenu Color="Color.Inherit"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight">

                        <ActivatorContent>
                            <div class="d-flex align-center mr-1" style="cursor: pointer;">
                                <MudAvatar Color="Color.Secondary"
                                           Size="Size.Medium"
                                           Class="mr-2">
                                    @GetInitials(DisplayName)
                                </MudAvatar>

                                <MudText Typo="Typo.body2" Style="color: white;">
                                    @DisplayName
                                </MudText>
                            </div>
                        </ActivatorContent>

                        <ChildContent>
                            <MudMenuItem>
                                <div class="d-flex align-center">
                                    <MudAvatar Color="Color.Primary"
                                               Size="Size.Small"
                                               Class="mr-2">
                                        @GetInitials(DisplayName)
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body2">@DisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @UserName
                                        </MudText>
                                    </div>
                                </div>
                            </MudMenuItem>

                            <MudDivider />

                            <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                         OnClick="Logout">
                                Abmelden
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Class="ml-2"
                                   Style="color: white;"
                                   OnClick="Logout" />
                </div>
            </MudAppBar>

            <MudDrawer @bind-Open="@_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
                <MudDrawerHeader>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.School"
                                 Color="Color.Primary"
                                 Size="Size.Large"
                                 Class="mr-2" />
                        <MudText Typo="Typo.h6" Color="Color.Primary">HTL Krems</MudText>
                    </div>
                </MudDrawerHeader>

                <MudNavMenu>
                    @if (_isStudent)
                    {
                        <MudNavLink Href="/student/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.Prefix">
                            Dashboard
                        </MudNavLink>

                        <MudNavLink Href="/student/grades" Icon="@Icons.Material.Filled.School">
                            Meine Noten
                        </MudNavLink>

                        <MudNavLink Href="/student/notifications" Icon="@Icons.Material.Filled.Notifications">
                            <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                <span>Benachrichtigungen</span>
                                @if (_unreadCount > 0)
                                {
                                    <MudChip T="int" Size="Size.Small" Color="Color.Error">
                                        @_unreadCount
                                    </MudChip>
                                }
                            </div>
                        </MudNavLink>
                    }
                    else if (_isTeacher)
                    {
                        <MudNavLink Href="/teacher/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.Prefix">
                            Dashboard
                        </MudNavLink>
                        <MudNavLink Href="/teacher/classes" Icon="@Icons.Material.Filled.Class">
                            Klassen
                        </MudNavLink>
                        <MudNavLink Href="/teacher/tests" Icon="@Icons.Material.Filled.Quiz">
                            Tests
                        </MudNavLink>
                        <MudNavLink Href="/teacher/gradeentry" Icon="@Icons.Material.Filled.EditNote">
                            Noten eintragen
                        </MudNavLink>
                        <MudNavLink Href="/teacher/warnings" Icon="@Icons.Material.Filled.WarningAmber">
                            Frühwarnsystem
                        </MudNavLink>
                    }
                    else if (_isAdmin)
                    {
                        <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.Prefix">
                            Dashboard
                        </MudNavLink>
                        <MudNavLink Href="/admin/teachers" Icon="@Icons.Material.Filled.People">
                            Lehrer
                        </MudNavLink>
                        <MudNavLink Href="/admin/classes" Icon="@Icons.Material.Filled.Class">
                            Klassen
                        </MudNavLink>
                        <MudNavLink Href="/admin/subjects" Icon="@Icons.Material.Filled.MenuBook">
                            Fächer
                        </MudNavLink>
                        <MudNavLink Href="/admin/backups" Icon="@Icons.Material.Filled.Backup">
                            Backups
                        </MudNavLink>
                        <MudNavLink Href="/admin/audit" Icon="@Icons.Material.Filled.History">
                            Audit
                        </MudNavLink>
                        
                    }
                    else
                    {
                        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Home</MudNavLink>
                        <MudNavLink Href="/secure" Icon="@Icons.Material.Filled.Lock">Secure</MudNavLink>
                    }
                </MudNavMenu>
            </MudDrawer>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-4">
                    @Body
                </MudContainer>
            </MudMainContent>

            @* Mobile Bottom Navigation (Student) *@
            @if (_isStudent)
            {
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudPaper Square="true" Elevation="3" Style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000;">
                        <MudBottomNavigation T="string"
                                             Color="Color.Primary"
                                             SelectedValue="@_selectedPage"
                                             SelectedValueChanged="@OnSelectedPageChanged">

                            <MudBottomNavigationItem T="string"
                                                     Value="dashboard"
                                                     Text="Dashboard"
                                                     Icon="@Icons.Material.Filled.Dashboard"
                                                     OnClick="@(() => SelectPage("dashboard", "/student/dashboard"))" />

                            <MudBottomNavigationItem T="string"
                                                     Value="grades"
                                                     Text="Noten"
                                                     Icon="@Icons.Material.Filled.School"
                                                     OnClick="@(() => SelectPage("grades", "/student/grades"))" />

                            <MudBottomNavigationItem T="string"
                                                     Value="notifications"
                                                     Text="Nachrichten"
                                                     Icon="@Icons.Material.Filled.Notifications"
                                                     OnClick="@(() => SelectPage("notifications", "/student/notifications"))">
                                <IconContent>
                                    <MudBadge Content="@_unreadCount"
                                              Color="Color.Error"
                                              Overlap="true"
                                              Visible="@(_unreadCount > 0)">
                                        <MudIcon Icon="@Icons.Material.Filled.Notifications" />
                                    </MudBadge>
                                </IconContent>
                            </MudBottomNavigationItem>

                        </MudBottomNavigation>
                    </MudPaper>
                </MudHidden>
            }
        </MudLayout>
    </Authorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    private string DisplayName => _displayName ?? "User";
    private string UserName => _userName ?? "";

    private string? _displayName;
    private string? _userName;

    private bool _isStudent;
    private bool _isTeacher;
    private bool _isAdmin;
    private int _unreadCount;
    private string _selectedPage = "dashboard";

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary          = "#29aae3",
            Secondary        = "#BDBDBD",
            Background       = "#FAFAFA",
            AppbarBackground = "#29aae3",
            DrawerBackground = "#ffffff",
            Success          = Colors.Green.Default,
            Warning          = Colors.Orange.Default,
            Error            = Colors.Red.Default
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _displayName = user.Identity?.Name
                       ?? user.FindFirst("name")?.Value
                       ?? user.FindFirst(ClaimTypes.Name)?.Value;

        _userName = user.FindFirst("preferred_username")?.Value
                    ?? user.FindFirst("upn")?.Value
                    ?? user.FindFirst(ClaimTypes.Email)?.Value;

        _isStudent = RoleHelper.HasRole(user, "Student");
        _isTeacher = RoleHelper.HasRole(user, "Teacher");
        _isAdmin = RoleHelper.HasRole(user, "Admin");

        if (_isStudent)
        {
            try { _unreadCount = await NotificationService.GetUnreadCountAsync(); }
            catch { _unreadCount = 0; }

            var uri = Nav.Uri.ToLowerInvariant();
            if (uri.Contains("/student/grades")) _selectedPage = "grades";
            else if (uri.Contains("/student/notifications")) _selectedPage = "notifications";
            else _selectedPage = "dashboard";
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void OnSelectedPageChanged(string value) => _selectedPage = value;

    private void SelectPage(string value, string url)
    {
        _selectedPage = value;
        Nav.NavigateTo(url);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name[..1].ToUpper();
    }
}

@code {
    void Logout() => Nav.NavigateToLogout("authentication/logout");
}

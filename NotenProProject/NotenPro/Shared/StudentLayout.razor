@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Edge="Edge.Start"
                       Style="color: white;"
                       OnClick="@ToggleDrawer" />

        <div class="d-flex flex-column">
            <MudText Typo="Typo.h6"
                     Class="mb-n1"
                     Style="color: white;">
                NotenPro
            </MudText>
            <MudText Typo="Typo.caption"
                     Style="color: white;">
                Schülerportal
            </MudText>
        </div>

        <MudSpacer />

        <!-- Notifications -->
        <MudBadge Content="@unreadCount"
                  Color="Color.Error"
                  Overlap="true"
                  Visible="@(unreadCount > 0)">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                           Style="color: white;"
                           OnClick="@(() => NavigateTo("/student/notifications"))" />
        </MudBadge>

        <!-- User Menu -->
        <MudMenu Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <div class="d-flex align-center ml-2" style="cursor: pointer;">
                    <MudAvatar Color="Color.Secondary"
                               Size="Size.Medium"
                               Class="mr-2">
                        @GetInitials(DisplayName)
                    </MudAvatar>
                    <MudText Typo="Typo.body2"
                             Style="color: white;">
                        @DisplayName
                    </MudText>
                </div>
            </ActivatorContent>

            <ChildContent>
                <MudMenuItem>
                    <div class="d-flex align-center">
                        <MudAvatar Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="mr-2">
                            @GetInitials(DisplayName)
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.body2">@DisplayName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Schüler
                            </MudText>
                        </div>
                    </div>
                </MudMenuItem>

                <MudDivider />

                <MudMenuItem Icon="@Icons.Material.Filled.DarkMode">
                    <div class="d-flex justify-space-between align-center" style="width: 100%;">
                        <span>Dark Mode</span>
                        <MudSwitch T="bool"
                                   Checked="@_isDarkMode"
                                   CheckedChanged="ToggleDarkMode"
                                   Color="Color.Primary"
                                   DisableRipple="true" />
                    </div>
                </MudMenuItem>

                <MudDivider />

                <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                             OnClick="@(() => NavigationManager.NavigateTo("authentication/logout"))">
                    Abmelden
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Class="ml-1"
                       Style="color: white;"
                       OnClick="@(() => NavigationManager.NavigateTo("authentication/logout"))" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="2"
               ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.School"
                         Color="Color.Primary"
                         Size="Size.Large"
                         Class="mr-2" />
                <MudText Typo="Typo.h6" Color="Color.Primary">HTL Krems</MudText>
            </div>
        </MudDrawerHeader>

        <MudNavMenu>
            <MudNavLink Href="/student/dashboard"
                        Icon="@Icons.Material.Filled.Dashboard"
                        Match="NavLinkMatch.Prefix">
                Dashboard
            </MudNavLink>

            <MudNavLink Href="/student/grades"
                        Icon="@Icons.Material.Filled.School">
                Meine Noten
            </MudNavLink>

            <MudNavLink Href="/student/notifications"
                        Icon="@Icons.Material.Filled.Notifications">
                <div class="d-flex justify-space-between align-center" style="width: 100%;">
                    <span>Benachrichtigungen</span>
                    @if (unreadCount > 0)
                    {
                        <MudChip T="int" Size="Size.Small" Color="Color.Error">
                            @unreadCount
                        </MudChip>
                    }
                </div>
            </MudNavLink>

            <MudNavLink Href="/student/map"
                        Icon="@Icons.Material.Filled.Map">
                Raumfinder
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-4">
            @ChildContent
        </MudContainer>
    </MudMainContent>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudPaper Square="true"
                  Elevation="3"
                  Style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000;">
            <MudBottomNavigation T="string"
                                 Color="Color.Primary"
                                 SelectedValue="@selectedPage"
                                 SelectedValueChanged="@OnSelectedPageChanged">

                <MudBottomNavigationItem T="string"
                                         Value="dashboard"
                                         Text="Dashboard"
                                         Icon="@Icons.Material.Filled.Dashboard"
                                         OnClick="@(() => SelectPage("dashboard", "/student/dashboard"))" />

                <MudBottomNavigationItem T="string"
                                         Value="grades"
                                         Text="Noten"
                                         Icon="@Icons.Material.Filled.School"
                                         OnClick="@(() => SelectPage("grades", "/student/grades"))" />

                <MudBottomNavigationItem T="string"
                                         Value="notifications"
                                         Text="Nachrichten"
                                         OnClick="@(() => SelectPage("notifications", "/student/notifications"))">
                    <IconContent>
                        <MudBadge Content="@unreadCount"
                                  Color="Color.Error"
                                  Overlap="true"
                                  Visible="@(unreadCount > 0)">
                            <MudIcon Icon="@Icons.Material.Filled.Notifications" />
                        </MudBadge>
                    </IconContent>
                </MudBottomNavigationItem>

                <MudBottomNavigationItem T="string"
                                         Value="map"
                                         Text="Raumfinder"
                                         Icon="@Icons.Material.Filled.Map"
                                         OnClick="@(() => SelectPage("map", "/student/map"))" />
            </MudBottomNavigation>
        </MudPaper>
    </MudHidden>
</MudLayout>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<bool> OnDarkModeChanged { get; set; }

    private bool _drawerOpen = true;
    private int unreadCount;
    private bool _isDarkMode;
    private string selectedPage = "dashboard";

    private string DisplayName => _displayName ?? "User";
    private string? _displayName;

    protected override async Task OnInitializedAsync()
    {
        // Claims holen
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _displayName =
            user.Identity?.Name ??
            user.FindFirst("name")?.Value ??
            user.FindFirst(ClaimTypes.Name)?.Value ??
            user.FindFirst("preferred_username")?.Value ??
            "User";

        // Notifications (dein Service)
        unreadCount = await NotificationService.GetUnreadCountAsync();

        // SelectedPage
        var uri = NavigationManager.Uri.ToLowerInvariant();
        if (uri.Contains("/student/grades"))
            selectedPage = "grades";
        else if (uri.Contains("/student/notifications"))
            selectedPage = "notifications";
        else if (uri.Contains("/student/map"))
            selectedPage = "map";
        else
            selectedPage = "dashboard";
    }

    private void OnSelectedPageChanged(string value) => selectedPage = value;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void NavigateTo(string url) => NavigationManager.NavigateTo(url);

    private void SelectPage(string value, string url)
    {
        selectedPage = value;
        NavigationManager.NavigateTo(url);
    }

    private async Task ToggleDarkMode(bool value)
    {
        _isDarkMode = value;
        if (OnDarkModeChanged.HasDelegate)
            await OnDarkModeChanged.InvokeAsync(value);
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name[..1].ToUpper();
    }
}

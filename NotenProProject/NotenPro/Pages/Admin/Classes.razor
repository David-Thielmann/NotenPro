@page "/admin/classes"
@using NotenPro.Shared.DTOs
@inject HttpClient Http
@inject IDialogService DialogService
@using MudBlazor

<PageTitle>Klassenverwaltung</PageTitle>

<MudContainer Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">Klassenverwaltung</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreateClassDialog">
            Neue Klasse
        </MudButton>
    </div>

    <MudTable Items="_classes" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Klassenname</MudTh>
            <MudTh>Klassenlehrer</MudTh>
            <MudTh>Schüler</MudTh>
            <MudTh Style="text-align:right">Aktionen</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Klassenname">@context.Name</MudTd>
            <MudTd DataLabel="Klassenlehrer">
                @if (!string.IsNullOrEmpty(context.TeacherName))
                {
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2" Color="Color.Info" />
                        <MudText Typo="Typo.body2">@context.TeacherName</MudText>
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Error"><i>Kein Lehrer</i></MudText>
                }
            </MudTd>
            <MudTd DataLabel="Schüler">
                <MudBadge Content="@context.StudentCount" Color="Color.Primary" Overlap="false" Bordered="true">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Default" />
                </MudBadge>
            </MudTd>
            <MudTd DataLabel="Aktionen" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="() => EditClass(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteClass(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<ClassDto> _classes = new();
    private List<TeacherDto> _teachers = new();

    protected override async Task OnInitializedAsync() 
    {
        await LoadClasses();
        await LoadTeachers();
    }

    private async Task LoadClasses()
    {
        _classes = await Http.GetFromJsonAsync<List<ClassDto>>("api/classes") ?? new();
    }

    private async Task LoadTeachers()
    {
        // Wir laden die Lehrer, um sie im Dialog zur Auswahl zu haben
        _teachers = await Http.GetFromJsonAsync<List<TeacherDto>>("api/teachers") ?? new();
    }

    private async Task ShowCreateClassDialog()
    {
        var parameters = new DialogParameters 
        { 
            ["ClassObj"] = new ClassDto(),
            ["Teachers"] = _teachers 
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<CreateClassDialog>("Neue Klasse", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is ClassDto newClass)
        {
            var response = await Http.PostAsJsonAsync("api/classes", newClass);
            if (response.IsSuccessStatusCode) await LoadClasses();
        }
    }

    private async Task EditClass(ClassDto classObj)
    {
        var classCopy = new ClassDto 
        { 
            Id = classObj.Id, 
            Name = classObj.Name, 
            SchoolId = classObj.SchoolId,
            TeacherId = classObj.TeacherId // Die ID für die Radio-Buttons
        };

        var parameters = new DialogParameters 
        { 
            ["ClassObj"] = classCopy,
            ["Teachers"] = _teachers 
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<CreateClassDialog>("Klasse bearbeiten", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is ClassDto updatedClass)
        {
            var response = await Http.PutAsJsonAsync($"api/classes/{updatedClass.Id}", updatedClass);
            if (response.IsSuccessStatusCode) await LoadClasses();
        }
    }

    private async Task DeleteClass(string id)
    {
        var response = await Http.DeleteAsync($"api/classes/{id}");
        if (response.IsSuccessStatusCode) await LoadClasses();
    }
}
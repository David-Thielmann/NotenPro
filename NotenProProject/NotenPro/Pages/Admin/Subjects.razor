@page "/admin/subjects"
@using NotenPro.Shared.DTOs
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDialogService DialogService
@using MudBlazor

<PageTitle>Fächerverwaltung</PageTitle>

<MudContainer Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">Fächerverwaltung</MudText>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="ShowCreateSubjectDialog">
            Neues Fach
        </MudButton>
    </div>

    <MudTable Items="subjects" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Beschreibung</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right">Aktionen</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Beschreibung">@context.Description</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                    @(context.IsActive ? "Aktiv" : "Inaktiv")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Aktionen" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="() => EditSubject(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteSubject(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<SubjectDto> subjects = new List<SubjectDto>();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!RoleHelper.HasRole(auth.User, "Admin"))
        {
            Nav.NavigateTo("/login", true);
        }

        await LoadSubjects();
    }

    private async Task LoadSubjects()
    {
        try 
        {
            var result = await Http.GetFromJsonAsync<List<SubjectDto>>("api/subjects");
            subjects = result ?? new List<SubjectDto>();
            StateHasChanged(); 
        } 
        catch (Exception ex) 
        {
            Console.WriteLine($"Fehler beim Laden der Fächer: {ex.Message}");
        }
    }

    private async Task ShowCreateSubjectDialog()
    {
        // Neues DTO initialisieren
        var parameters = new DialogParameters { ["Subject"] = new SubjectDto { IsActive = true } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = DialogService.Show<CreateSubjectDialog>("Neues Fach", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is SubjectDto createdSubject)
        {
            // WICHTIG: Da school_id in deiner Entity [Required] ist, 
            // stellen wir sicher, dass sie nicht leer gesendet wird, falls sie im DTO fehlt.
            // Ersetze die ID unten durch eine existierende ID aus deiner "schools" Tabelle!
            if (string.IsNullOrEmpty(createdSubject.SchoolId))
            {
                createdSubject.SchoolId = "e1000000-0000-0000-0000-000000000005"; 
            }

            var response = await Http.PostAsJsonAsync("api/subjects", createdSubject);
            
            if (response.IsSuccessStatusCode)
            {
                await LoadSubjects(); 
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Fehler beim Speichern (Status 500 verhindern): {error}");
            }
        }
    }

    private async Task EditSubject(SubjectDto subject) 
    { 
        // Kopie erstellen, inklusive der SchoolId für die Datenbank-Validierung
        var subjectCopy = new SubjectDto 
        { 
            Id = subject.Id, 
            Name = subject.Name, 
            Description = subject.Description, 
            IsActive = subject.IsActive,
            SchoolId = subject.SchoolId
        };

        var parameters = new DialogParameters { ["Subject"] = subjectCopy };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = DialogService.Show<CreateSubjectDialog>("Fach bearbeiten", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is SubjectDto updatedSubject)
        {
            // PUT-Aufruf zum Überschreiben der Daten
            var response = await Http.PutAsJsonAsync($"api/subjects/{updatedSubject.Id}", updatedSubject);
            
            if (response.IsSuccessStatusCode)
            {
                await LoadSubjects(); 
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Fehler beim Bearbeiten: {error}");
            }
        }
    }

    private async Task DeleteSubject(string id)
    {
        var response = await Http.DeleteAsync($"api/subjects/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadSubjects();
        }
    }
}
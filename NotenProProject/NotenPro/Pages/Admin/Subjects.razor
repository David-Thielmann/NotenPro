@page "/admin/subjects"
@inject ISubjectService SubjectService
@inject ISnackbar Snackbar

<PageTitle>Fächerverwaltung</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <MudText Typo="Typo.h4">Fächerverwaltung</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Add" 
               Variant="Variant.Filled" 
               Color="Color.Primary"
               OnClick="OpenCreateDialog">
        Neues Fach
    </MudButton>
</div>

<!-- Search -->
<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="searchText"
                              Label="Suche"
                              Placeholder="Fach suchen..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect @bind-Value="filterStatus" Label="Status">
                    <MudSelectItem Value="@("")">Alle</MudSelectItem>
                    <MudSelectItem Value="@("active")">Aktiv</MudSelectItem>
                    <MudSelectItem Value="@("inactive")">Inaktiv</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Subjects Grid -->
@if (loading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else
{
    <MudGrid>
        @foreach (var subject in FilteredSubjects)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@subject.Name</MudText>
                            @if (!string.IsNullOrEmpty(subject.Code))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@subject.Code</MudText>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudSwitch T="bool"
                                       @bind-Checked="subject.IsActive" 
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       ThumbIcon="@(subject.IsActive ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                       OnChange="@(() => ToggleSubjectStatus(subject))" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (!string.IsNullOrEmpty(subject.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                @subject.Description
                            </MudText>
                        }
                        <div class="d-flex gap-2 flex-wrap mt-2">
                            @if (subject.HoursPerWeek > 0)
                            {
                                <MudChip T="bool"
                                    Size="Size.Small" Icon="@Icons.Material.Filled.Schedule">
                                    @subject.HoursPerWeek Std./Woche
                                </MudChip>
                            }
                            @if (!string.IsNullOrEmpty(subject.Department))
                            {
                                <MudChip T="bool"
                                    Size="Size.Small" Color="Color.Info">
                                    @subject.Department
                                </MudChip>
                            }
                        </div>
                    </MudCardContent>
                    <MudCardActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(subject))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteSubject(subject))" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (!FilteredSubjects.Any())
    {
        <MudAlert Severity="Severity.Info">
            Keine Fächer gefunden. Erstellen Sie ein neues Fach.
        </MudAlert>
    }
}

<!-- Create/Edit Dialog -->
<MudDialog @bind-IsVisible="showDialog" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(isEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(isEditMode ? "Fach bearbeiten" : "Neues Fach")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="editingSubject.Name"
                              Label="Fachbezeichnung"
                              Required="true"
                              Variant="Variant.Outlined"
                              Placeholder="z.B. Mathematik" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="editingSubject.Code"
                              Label="Kürzel"
                              Variant="Variant.Outlined"
                              Placeholder="z.B. MATH" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="editingSubject.Description"
                              Label="Beschreibung"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Placeholder="Optional" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="editingSubject.Department"
                           Label="Abteilung"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    <MudSelectItem Value="@("Informatik")">Informatik</MudSelectItem>
                    <MudSelectItem Value="@("Elektronik")">Elektronik</MudSelectItem>
                    <MudSelectItem Value="@("Maschinenbau")">Maschinenbau</MudSelectItem>
                    <MudSelectItem Value="@("Allgemeinbildung")">Allgemeinbildung</MudSelectItem>
                    <MudSelectItem Value="@("Sprachen")">Sprachen</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="editingSubject.HoursPerWeek"
                                 Label="Wochenstunden"
                                 Min="0"
                                 Max="20"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool"
                           @bind-Checked="editingSubject.IsActive" 
                           Color="Color.Primary"
                           Label="Fach ist aktiv" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="SaveSubject">
            @(isEditMode ? "Speichern" : "Erstellen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<SubjectModel> subjects = new();
    
    private string searchText = "";
    private string filterStatus = "";
    private bool loading = true;
    
    private bool showDialog = false;
    private bool isEditMode = false;
    private SubjectModel editingSubject = new();
    
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private IEnumerable<SubjectModel> FilteredSubjects
    {
        get
        {
            var filtered = subjects.AsEnumerable();
            
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var search = searchText.ToLowerInvariant();
                filtered = filtered.Where(s => 
                    s.Name.ToLowerInvariant().Contains(search) ||
                    (s.Code?.ToLowerInvariant().Contains(search) ?? false) ||
                    (s.Description?.ToLowerInvariant().Contains(search) ?? false));
            }
            
            if (filterStatus == "active")
                filtered = filtered.Where(s => s.IsActive);
            else if (filterStatus == "inactive")
                filtered = filtered.Where(s => !s.IsActive);
            
            return filtered.OrderBy(s => s.Name);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        
        var subjectsData = await SubjectService.GetSubjectsAsync();
        
        // Convert to SubjectModel with additional properties
        subjects = subjectsData.Select(s => new SubjectModel
        {
            Id = s.Id,
            Name = s.Name,
            Code = GetSubjectCode(s.Name),
            Description = GetSubjectDescription(s.Name),
            Department = GetSubjectDepartment(s.Name),
            HoursPerWeek = GetSubjectHours(s.Name),
            IsActive = true
        }).ToList();
        
        loading = false;
    }

    private void OpenCreateDialog()
    {
        isEditMode = false;
        editingSubject = new SubjectModel
        {
            IsActive = true,
            HoursPerWeek = 2
        };
        showDialog = true;
    }

    private void OpenEditDialog(SubjectModel subject)
    {
        isEditMode = true;
        editingSubject = new SubjectModel
        {
            Id = subject.Id,
            Name = subject.Name,
            Code = subject.Code,
            Description = subject.Description,
            Department = subject.Department,
            HoursPerWeek = subject.HoursPerWeek,
            IsActive = subject.IsActive
        };
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
    }

    private async Task SaveSubject()
{
    if (string.IsNullOrWhiteSpace(editingSubject.Name))
    {
        Snackbar.Add("Bitte geben Sie eine Fachbezeichnung ein", Severity.Warning);
        return;
    }

    if (isEditMode)
    {
        var existingSubject = subjects.FirstOrDefault(s => s.Id == editingSubject.Id);
        if (existingSubject != null)
        {
            existingSubject.Name         = editingSubject.Name;
            existingSubject.Code         = editingSubject.Code;
            existingSubject.Description  = editingSubject.Description;
            existingSubject.Department   = editingSubject.Department;
            existingSubject.HoursPerWeek = editingSubject.HoursPerWeek;
            existingSubject.IsActive     = editingSubject.IsActive;
        }

        Snackbar.Add("Fach aktualisiert", Severity.Success);
    }
    else
    {
        // Domain-Subject für den Service bauen
        var newSubject = new HTLKrems.GradeManagement.Models.Subject
        {
            Name         = editingSubject.Name!,
            Code         = editingSubject.Code,
            Description  = editingSubject.Description,
            Department   = editingSubject.Department,
            HoursPerWeek = editingSubject.HoursPerWeek,
            IsActive     = editingSubject.IsActive
        };

        var result = await SubjectService.CreateSubjectAsync(newSubject);

        if (result.Success)
        {
            // Falls dein ApiResponse<Subject> die echte Id liefert: result.Data?.Id verwenden
            editingSubject.Id ??= Guid.NewGuid().ToString();

            subjects.Add(new SubjectModel
            {
                Id           = editingSubject.Id,
                Name         = editingSubject.Name,
                Code         = editingSubject.Code,
                Description  = editingSubject.Description,
                Department   = editingSubject.Department,
                HoursPerWeek = editingSubject.HoursPerWeek,
                IsActive     = editingSubject.IsActive
            });

            Snackbar.Add("Fach erstellt", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Fehler: {result.Message}", Severity.Error);
            return;
        }
    }

    CloseDialog();
}


    private async Task DeleteSubject(SubjectModel subject)
    {
        var result = await SubjectService.DeleteSubjectAsync(subject.Id);
        if (result.Success)
        {
            subjects.Remove(subject);
            Snackbar.Add("Fach gelöscht", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Fehler: {result.Message}", Severity.Error);
        }
    }

    private void ToggleSubjectStatus(SubjectModel subject)
    {
        var status = subject.IsActive ? "aktiviert" : "deaktiviert";
        Snackbar.Add($"{subject.Name} wurde {status}", Severity.Info);
    }

    // Helper methods for mock data
    private string GetSubjectCode(string name) => name switch
    {
        "Mathematik" => "MATH",
        "Programmieren" => "PROG",
        "Datenbanken" => "DBI",
        "Netzwerktechnik" => "NWT",
        "Webentwicklung" => "WEB",
        "Englisch" => "ENGL",
        "Deutsch" => "DEU",
        _ => name.Length >= 3 ? name.Substring(0, 3).ToUpper() : name.ToUpper()
    };

    private string GetSubjectDescription(string name) => name switch
    {
        "Mathematik" => "Grundlagen der Mathematik und Analysis",
        "Programmieren" => "Objektorientierte Programmierung mit C# und Java",
        "Datenbanken" => "Relationale Datenbanken und SQL",
        "Netzwerktechnik" => "Netzwerkprotokolle und -administration",
        "Webentwicklung" => "Frontend und Backend Webentwicklung",
        _ => ""
    };

    private string GetSubjectDepartment(string name) => name switch
    {
        "Mathematik" => "Allgemeinbildung",
        "Programmieren" => "Informatik",
        "Datenbanken" => "Informatik",
        "Netzwerktechnik" => "Informatik",
        "Webentwicklung" => "Informatik",
        "Englisch" => "Sprachen",
        "Deutsch" => "Sprachen",
        _ => "Allgemeinbildung"
    };

    private int GetSubjectHours(string name) => name switch
    {
        "Mathematik" => 4,
        "Programmieren" => 8,
        "Datenbanken" => 4,
        "Netzwerktechnik" => 3,
        "Webentwicklung" => 6,
        "Englisch" => 3,
        "Deutsch" => 2,
        _ => 2
    };

    private class SubjectModel
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public int HoursPerWeek { get; set; }
        public bool IsActive { get; set; } = true;
    }
}

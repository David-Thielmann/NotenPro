@page "/admin/teachers"
@using NotenPro.Shared.DTOs
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using MudBlazor

<PageTitle>Lehrerverwaltung</PageTitle>

<MudContainer Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">Lehrerverwaltung</MudText>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="ShowCreateTeacherDialog">
            Neuer Lehrer
        </MudButton>
    </div>

    @if (_subjects == null || !_subjects.Any())
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Achtung: Es wurden keine Fächer gefunden. Bitte erstelle zuerst Fächer in der Fächerverwaltung, damit du sie Lehrern zuweisen kannst.
        </MudAlert>
    }

    <MudTable Items="_teachers" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Fach</MudTh>
            <MudTh>E-Mail</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right">Aktionen</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Fach">@context.SubjectName</MudTd>
            <MudTd DataLabel="E-Mail">@context.Email</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                    @(context.IsActive ? "Aktiv" : "Inaktiv")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Aktionen" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="() => EditTeacher(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteTeacher(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<TeacherDto> _teachers = new();
    private List<SubjectDto> _subjects = new();

    protected override async Task OnInitializedAsync() 
    {
        await LoadTeachers();
        await LoadSubjects();
    }

    private async Task LoadTeachers()
    {
        try {
            _teachers = await Http.GetFromJsonAsync<List<TeacherDto>>("api/teachers") ?? new();
        } catch (Exception ex) {
            Console.WriteLine($"Fehler Lehrer: {ex.Message}");
        }
    }

    private async Task LoadSubjects()
    {
        try 
        {
            Console.WriteLine("DEBUG: Starte Laden der Fächer von api/subjects...");
        
            // 1. Roh-Antwort abrufen, um den Statuscode zu prüfen
            var response = await Http.GetAsync("api/subjects");
            Console.WriteLine($"DEBUG: API Status Code: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                // 2. Den Inhalt als Text lesen, um zu sehen, was WIRKLICH ankommt
                var jsonString = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"DEBUG: Rohdaten vom Server: {jsonString}");

                if (string.IsNullOrWhiteSpace(jsonString) || jsonString == "[]")
                {
                    Console.WriteLine("DEBUG: WARNUNG - Der Server hat eine leere Liste [] zurückgegeben.");
                    _subjects = new List<SubjectDto>();
                }
                else
                {
                    // 3. Deserialisieren
                    _subjects = await response.Content.ReadFromJsonAsync<List<SubjectDto>>() ?? new();
                    Console.WriteLine($"DEBUG: Erfolg! {_subjects.Count} Fächer erfolgreich in Liste geladen.");
                }
            }
            else 
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"DEBUG: FEHLER beim API-Aufruf: {errorBody}");
            }
        } 
        catch (Exception ex) 
        {
            Console.WriteLine($"DEBUG: CRASH in LoadSubjects: {ex.Message}");
        }
    }

    private async Task ShowCreateTeacherDialog()
    {
        // DEBUG: Prüfen, ob wir hier wirklich Daten haben
        Console.WriteLine($"Öffne Dialog mit {_subjects.Count} Fächern");

        var parameters = new DialogParameters 
        { 
            ["Teacher"] = new TeacherDto { IsActive = true },
            ["Subjects"] = _subjects  // <--- Hier muss die Liste rein
        };
    
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
    
        // Wichtig: Warte nicht auf das Resultat, bevor der Dialog überhaupt erscheint
        var dialog = DialogService.Show<CreateTeacherDialog>("Neuer Lehrer", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateTeacherRequest request)
        {
            await Http.PostAsJsonAsync("api/teachers", request);
            await LoadTeachers();
        }
    }

    private async Task EditTeacher(TeacherDto teacher)
    {
        var parameters = new DialogParameters 
        { 
            ["Teacher"] = new TeacherDto 
            { 
                Id = teacher.Id, 
                Name = teacher.Name, 
                Email = teacher.Email,
                IsActive = teacher.IsActive,
                PrimarySubjectId = teacher.PrimarySubjectId // <--- WICHTIG: Muss hier mitgegeben werden
            },
            ["Subjects"] = _subjects 
        };
    
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<CreateTeacherDialog>("Lehrer bearbeiten", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateTeacherRequest request)
        {
            // PUT-Aufruf an das Backend
            var response = await Http.PutAsJsonAsync($"api/teachers/{request.Teacher.Id}", request.Teacher);
            if (response.IsSuccessStatusCode) 
            {
                Snackbar.Add("Änderungen gespeichert", Severity.Success);
                await LoadTeachers(); // Liste neu laden, um das neue Fach anzuzeigen
            }
        }
    }

    private async Task DeleteTeacher(string id)
    {
        var response = await Http.DeleteAsync($"api/teachers/{id}");
        if (response.IsSuccessStatusCode) await LoadTeachers();
    }
}
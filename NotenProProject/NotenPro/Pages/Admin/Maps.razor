@page "/admin/maps"
@inject ISnackbar Snackbar

<PageTitle>Raumpläne verwalten</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <MudText Typo="Typo.h4">Raumpläne verwalten</MudText>
</div>

<!-- Upload Card -->
<MudCard Elevation="2" Class="mb-4">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Neuen Raumplan hochladen</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect @bind-Value="selectedFloor" 
                           Label="Stockwerk" 
                           Required="true"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value="@("EG")">Erdgeschoss</MudSelectItem>
                    <MudSelectItem Value="@("1.OG")">1. Obergeschoss</MudSelectItem>
                    <MudSelectItem Value="@("2.OG")">2. Obergeschoss</MudSelectItem>
                    <MudSelectItem Value="@("3.OG")">3. Obergeschoss</MudSelectItem>
                    <MudSelectItem Value="@("UG")">Untergeschoss</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="mapDescription"
                              Label="Beschreibung"
                              Variant="Variant.Outlined"
                              Placeholder="Optional" />
            </MudItem>
            <MudItem xs="12">
                <MudFileUpload T="IBrowserFile" 
                               FilesChanged="HandleFileUpload"
                               Accept=".png,.jpg,.jpeg,.pdf,.svg">
                    <ButtonTemplate>
                        <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" 
                                  Outlined="true"
                                  Style="border-style: dashed; cursor: pointer; min-height: 200px;">
                            @if (uploadedFile == null)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" 
                                         Size="Size.Large" 
                                         Color="Color.Primary" />
                                <MudText Typo="Typo.h6" Class="mt-2">Datei hochladen</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Drag & Drop oder klicken Sie hier
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    Unterstützte Formate: PNG, JPG, PDF, SVG (Max. 10MB)
                                </MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" 
                                         Size="Size.Large" 
                                         Color="Color.Success" />
                                <MudText Typo="Typo.h6" Class="mt-2">@uploadedFile.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @FormatFileSize(uploadedFile.Size)
                                </MudText>
                            }
                        </MudPaper>
                    </ButtonTemplate>
                </MudFileUpload>
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Outlined" 
                           OnClick="ClearUpload"
                           Disabled="uploadedFile == null">
                    Zurücksetzen
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Upload" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary"
                           OnClick="UploadMap"
                           Disabled="uploadedFile == null || string.IsNullOrEmpty(selectedFloor)"
                           Loading="uploading">
                    Hochladen
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Uploaded Maps -->
<MudCard Elevation="2">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Hochgeladene Raumpläne</MudText>
    </MudCardHeader>
    <MudCardContent>
        @if (loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!uploadedMaps.Any())
        {
            <MudAlert Severity="Severity.Info">
                Noch keine Raumpläne hochgeladen. Laden Sie den ersten Plan hoch!
            </MudAlert>
        }
        else
        {
            <MudTable Items="@uploadedMaps" Hover="true" Dense="false">
                <HeaderContent>
                    <MudTh>Vorschau</MudTh>
                    <MudTh>Stockwerk</MudTh>
                    <MudTh>Beschreibung</MudTh>
                    <MudTh>Dateiname</MudTh>
                    <MudTh>Größe</MudTh>
                    <MudTh>Hochgeladen</MudTh>
                    <MudTh>Aktionen</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Vorschau">
                        <MudAvatar Size="Size.Large" 
                                   Variant="Variant.Outlined"
                                   Style="border-radius: 4px;">
                            <MudIcon Icon="@GetFileIcon(context.FileName)" />
                        </MudAvatar>
                    </MudTd>
                    <MudTd DataLabel="Stockwerk">
                        <MudChip Size="Size.Small" Color="Color.Primary">@context.Floor</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Beschreibung">
                        @if (!string.IsNullOrEmpty(context.Description))
                        {
                            <MudText>@context.Description</MudText>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary" Typo="Typo.caption">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Dateiname">@context.FileName</MudTd>
                    <MudTd DataLabel="Größe">@FormatFileSize(context.Size)</MudTd>
                    <MudTd DataLabel="Hochgeladen">@context.UploadDate.ToString("dd.MM.yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Aktionen">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       Title="Vorschau"
                                       OnClick="@(() => PreviewMap(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Download" 
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       Title="Herunterladen"
                                       OnClick="@(() => DownloadMap(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Title="Löschen"
                                       OnClick="@(() => DeleteMap(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

<!-- Preview Dialog -->
<MudDialog @bind-IsVisible="showPreviewDialog" Options="previewDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Map" Class="mr-2" />
            Raumplan Vorschau - @selectedMap?.Floor
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (selectedMap != null)
        {
            <div class="d-flex flex-column gap-2 mb-4">
                <MudText Typo="Typo.body2"><strong>Datei:</strong> @selectedMap.FileName</MudText>
                <MudText Typo="Typo.body2"><strong>Stockwerk:</strong> @selectedMap.Floor</MudText>
                @if (!string.IsNullOrEmpty(selectedMap.Description))
                {
                    <MudText Typo="Typo.body2"><strong>Beschreibung:</strong> @selectedMap.Description</MudText>
                }
            </div>
            
            <MudPaper Class="pa-4 d-flex align-center justify-center" Outlined="true" Style="min-height: 400px;">
                <div class="d-flex flex-column align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                        Vorschau wird geladen...
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        (In der Produktionsversion würde hier die Karte angezeigt)
                    </MudText>
                </div>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ClosePreview">Schließen</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="@(() => DownloadMap(selectedMap))">
            Herunterladen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<MapFile> uploadedMaps = new();
    
    private IBrowserFile? uploadedFile;
    private string selectedFloor = "";
    private string mapDescription = "";
    
    private bool loading = false;
    private bool uploading = false;
    
    private bool showPreviewDialog = false;
    private MapFile? selectedMap;
    
    private DialogOptions previewDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadMaps();
    }

    private async Task LoadMaps()
    {
        loading = true;
        
        // Mock data
        uploadedMaps = new List<MapFile>
        {
            new MapFile
            {
                Id = Guid.NewGuid().ToString(),
                Floor = "EG",
                Description = "Haupteingang und Verwaltung",
                FileName = "erdgeschoss.png",
                Size = 1024 * 512,
                UploadDate = DateTime.Now.AddDays(-10)
            },
            new MapFile
            {
                Id = Guid.NewGuid().ToString(),
                Floor = "1.OG",
                Description = "Klassenräume 1AHIF - 2BHIF",
                FileName = "obergeschoss_1.pdf",
                Size = 1024 * 768,
                UploadDate = DateTime.Now.AddDays(-8)
            },
            new MapFile
            {
                Id = Guid.NewGuid().ToString(),
                Floor = "2.OG",
                Description = "Laborräume und Werkstätten",
                FileName = "obergeschoss_2.jpg",
                Size = 1024 * 1024 * 2,
                UploadDate = DateTime.Now.AddDays(-5)
            }
        };
        
        loading = false;
    }

    private void HandleFileUpload(IBrowserFile file)
    {
        uploadedFile = file;
    }

    private void ClearUpload()
    {
        uploadedFile = null;
        selectedFloor = "";
        mapDescription = "";
    }

    private async Task UploadMap()
    {
        if (uploadedFile == null || string.IsNullOrEmpty(selectedFloor))
            return;

        uploading = true;

        // Simulate upload delay
        await Task.Delay(1000);

        var newMap = new MapFile
        {
            Id = Guid.NewGuid().ToString(),
            Floor = selectedFloor,
            Description = mapDescription,
            FileName = uploadedFile.Name,
            Size = uploadedFile.Size,
            UploadDate = DateTime.Now
        };

        uploadedMaps.Add(newMap);
        
        Snackbar.Add($"Raumplan für {selectedFloor} erfolgreich hochgeladen", Severity.Success);
        
        ClearUpload();
        uploading = false;
    }

    private void PreviewMap(MapFile? map)
    {
        selectedMap = map;
        showPreviewDialog = true;
    }

    private void ClosePreview()
    {
        showPreviewDialog = false;
        selectedMap = null;
    }

    private void DownloadMap(MapFile? map)
    {
        if (map != null)
        {
            Snackbar.Add($"{map.FileName} wird heruntergeladen...", Severity.Info);
        }
    }

    private void DeleteMap(MapFile map)
    {
        uploadedMaps.Remove(map);
        Snackbar.Add($"Raumplan für {map.Floor} gelöscht", Severity.Success);
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        
        return $"{len:0.##} {sizes[order]}";
    }

    private string GetFileIcon(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        return extension switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".png" or ".jpg" or ".jpeg" => Icons.Material.Filled.Image,
            ".svg" => Icons.Material.Filled.PhotoLibrary,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    private class MapFile
    {
        public string Id { get; set; } = string.Empty;
        public string Floor { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public long Size { get; set; }
        public DateTime UploadDate { get; set; }
    }
}

@page "/student/grades"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IGradeService GradeService
@inject IPdfExportService PdfExportService
@inject NavigationManager Navigation
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject IDialogService DialogService
@using MudBlazor

<PageTitle>Meine Noten</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <MudText Typo="Typo.h4">Meine Noten</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Download"
               Variant="Variant.Outlined"
               Color="Color.Primary"
               OnClick="ExportPdf">
        Exportieren
    </MudButton>
</div>


@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <!-- ================== DASHBOARD OBEN ================== -->
    <MudGrid Class="mb-4">
        <!-- großer Card mit Durchschnitt + Fortschritt -->
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="8">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                Aktueller Notendurchschnitt
                            </MudText>
                            <MudText Typo="Typo.h3" Class="mt-1">
                                @averageGrade.ToString("0.00")
                            </MudText>

                            <MudText Typo="Typo.caption" Class="mt-4 mb-1">
                                Gesamtleistung
                            </MudText>
                            <MudProgressLinear Value="@overallPerformancePercent"
                                               Rounded="true"
                                               Color="Color.Primary" />
                        </MudItem>

                        <MudItem xs="12" md="4" Class="d-flex flex-column align-end justify-center">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents"
                                     Size="Size.Large"
                                     Class="mb-2" />
                            <MudText Typo="Typo.subtitle1">
                                @($"{overallPerformancePercent:0}%")
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- kleinere Info-Cards -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mt-4">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Success">
                        Beste Note
                    </MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">
                        @bestGrade.ToString("0.0")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mt-4">
                <MudCardContent>
                    <MudText Typo="Typo.caption">
                        Fächer
                    </MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">
                        @subjectCount
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mt-4">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Error">
                        Tests
                    </MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">
                        @testCount
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
    <!-- ================== /DASHBOARD OBEN ================== -->

    <!-- Filters -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <!-- Dropdown Fächer -->
                    <MudSelect T="string"
                               @bind-Value="selectedSubject"
                               Label="Fach"
                               Variant="Variant.Outlined"
                               Clearable="true">

                        <MudSelectItem T="string" Value="@string.Empty">Alle Fächer</MudSelectItem>

                        @foreach (var subject in subjects)
                        {
                            <MudSelectItem T="string" Value="@subject">@subject</MudSelectItem>
                        }

                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="searchString" 
                                  Label="Suchen" 
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <!-- Grades Table -->
    <MudCard Elevation="2">
        <MudCardContent>
            <MudTable Items="@filteredGrades" Hover="true" Breakpoint="Breakpoint.Sm" Dense="@isMobile">
                <HeaderContent>
                    <MudTh>Fach</MudTh>
                    <MudTh>Test</MudTh>
                    <MudTh>Note</MudTh>
                    <MudTh>Punkte</MudTh>
                    <MudTh>Datum</MudTh>
                    <MudTh>Lehrer</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Fach">@context.Subject</MudTd>
                    <MudTd DataLabel="Test">@context.TestName</MudTd>
                    <MudTd DataLabel="Note">
                        <MudChip T="decimal"
                                 Color="@GetGradeColor(context.GradeValue)"
                                 Size="Size.Small">
                            @context.GradeValue
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Punkte">
                        @if (context.Points.HasValue && context.MaxPoints.HasValue)
                        {
                            <MudText>@context.Points/@context.MaxPoints</MudText>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Datum">@context.Date.ToString("dd.MM.yyyy")</MudTd>
                    <MudTd DataLabel="Lehrer">@context.TeacherName</MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                </PagerContent>

            </MudTable>
        </MudCardContent>
    </MudCard>
}

@code {
    private bool isLoading = true;
    private bool isMobile = false;

    private List<Grade> grades = new();
    private List<string> subjects = new();

    private string selectedSubject = "";
    private string searchString = "";

    // Dashboard-Properties
    private decimal averageGrade;
    private decimal bestGrade;
    private int subjectCount;
    private int testCount;
    private double overallPerformancePercent;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        grades = await GradeService.GetMyGradesAsync();

        // Alle Fächer des Schülers extrahieren
        subjects = grades
            .Select(g => g.Subject)
            .Distinct()
            .OrderBy(s => s)
            .ToList();

        CalculateStats();

        isLoading = false;
    }

    private void CalculateStats()
    {
        if (!grades.Any())
        {
            averageGrade = 0;
            bestGrade = 0;
            subjectCount = 0;
            testCount = 0;
            overallPerformancePercent = 0;
            return;
        }

        averageGrade = Math.Round(grades.Average(g => g.GradeValue), 2);
        bestGrade = grades.Min(g => g.GradeValue);
        subjectCount = subjects.Count;
        testCount = grades.Count; // oder distinct Testnamen

        // Performance in % (1 = beste Note, 5 = schlechteste)
        const decimal bestPossible = 1m;
        const decimal worstPossible = 5m;
        var normalized = (worstPossible - averageGrade) / (worstPossible - bestPossible);

        if (normalized < 0) normalized = 0;
        if (normalized > 1) normalized = 1;

        overallPerformancePercent = (double)(normalized * 100m);
    }

    private IEnumerable<Grade> filteredGrades =>
        grades
            .Where(g => string.IsNullOrWhiteSpace(selectedSubject) || g.Subject == selectedSubject)
            .Where(g =>
                string.IsNullOrWhiteSpace(searchString) ||
                g.Subject.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                g.TestName.Contains(searchString, StringComparison.OrdinalIgnoreCase));

    private Color GetGradeColor(decimal grade)
    {
        return grade <= 2.0m
            ? Color.Success
            : grade <= 3.5m
                ? Color.Warning
                : Color.Error;
    }

    private async Task ExportPdf()
    {
        try
        {
            var studentId = grades.FirstOrDefault()?.StudentId;

            if (string.IsNullOrWhiteSpace(studentId))
            {
                Snackbar.Add("Keine Schüler-ID gefunden – es sind keine Noten geladen.", Severity.Error);
                return;
            }

            var response = await Http.GetAsync($"api/grades/export/student/{studentId}");

            if (!response.IsSuccessStatusCode)
            {
                var msg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Export fehlgeschlagen ({(int)response.StatusCode}): {msg}", Severity.Error);
                return;
            }

            var bytes  = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync(
                "blazorDownloadFile",
                "noten.pdf",
                "application/pdf",
                base64
            );
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Export: {ex.Message}", Severity.Error);
        }
    }

    
}

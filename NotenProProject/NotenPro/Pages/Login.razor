@page "/login"
@inject NavigationManager Nav

<PageTitle>Login – NotenPro</PageTitle>

<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Inter, Roboto, Arial, sans-serif;
}

#app {
    width: 100vw;
    height: 100vh;
}

.login-bg {
    height: 100vh;
    width: 100vw;
    background: linear-gradient(135deg, #29aae3 0%, #1b7fb8 100%);
    display: flex;
    justify-content: center;
    align-items: center;
}

.login-card {
    width: 520px;              /* ⬅ größer */
    padding: 48px 44px;
    border-radius: 20px;
    background: white;
    text-align: center;
    box-shadow: 0 35px 80px rgba(0,0,0,0.22);
    animation: fadeInUp .6s ease-out;
}

.keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.logo-circle {
    width: 96px;               /* ⬅ größer */
    height: 96px;
    border-radius: 50%;
    background: #29aae3;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 28px auto;
    box-shadow: 0 15px 35px rgba(41,170,227,.5);
}

.login-title {
    font-size: 28px;
    font-weight: 600;
    margin-top: 6px;
}

.login-subtitle {
    color: #6b7280;
    font-size: 15px;
    margin-top: 6px;
}

.login-btn {
    margin-top: 36px;
    height: 54px;              /* ⬅ höher */
    font-size: 17px;
    border-radius: 12px;
    transition: transform .15s ease, box-shadow .15s ease;
}

.login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(41,170,227,.45);
}

.demo-box {
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid #e5e7eb;
    font-size: 13px;
    color: #6b7280;
    text-align: left;
}
</style>


<div class="login-bg">
    <div class="login-card">

        <div class="logo-circle">
            <MudIcon Icon="@Icons.Material.Filled.School"
                     Style="color:white; font-size:34px;" />
        </div>

        <MudText Typo="Typo.h5" Align="Align.Center">
            NotenPro
        </MudText>

        <div class="login-subtitle">
            HTL Krems · Notenverwaltung
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="login-btn"
                   OnClick="BeginLogin">
            Mit Microsoft anmelden
        </MudButton>

        <div class="demo-box">
            <strong>Demo-Accounts:</strong>
            <ul>
                <li>schueler@htl-krems.at (Schüler)</li>
                <li>lehrer@htl-krems.at (Lehrer)</li>
                <li>schuldadmin@htl-krems.at (Admin)</li>
                <li>verwalter@htl-krems.at (System)</li>
            </ul>
        </div>

    </div>
</div>

@code {
private void BeginLogin()
{
// offizieller Entra / MSAL Login
Nav.NavigateTo("authentication/login", forceLoad: true);
}
}

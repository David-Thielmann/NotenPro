@page "/login"
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Style="margin-top: 10vh;">
    <MudPaper Elevation="3" Class="pa-8">
        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" Style="font-size: 64px;" />
            <MudText Typo="Typo.h5" Class="mt-4">Weiterleitung zur Microsoft-Anmeldung…</MudText>
            <MudProgressLinear Indeterminate="true" Class="mt-6" />
        </div>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="@(() => Nav.NavigateTo("authentication/login"))">
            Mit Microsoft anmelden
        </MudButton>
    </MudPaper>
</MudContainer>

@code{
    protected override void OnInitialized()
    {
        // Auto-Redirect
        Nav.NavigateTo("authentication/login");
    }
}
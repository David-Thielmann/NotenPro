@page "/teacher/tests"
@using NotenPro.Shared.DTOs
@using CreateTestRequest = NotenPro.Shared.DTOs.CreateTestRequest
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Tests & Prüfungen</PageTitle>

<MudContainer Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h4">Tests & Prüfungen</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" 
                   Color="Color.Primary" OnClick="OpenCreateDialog">Neuer Test</MudButton>
    </div>

    <MudTable Items="@tests" T="TestDto" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Titel</MudTh>
            <MudTh>Fach</MudTh>
            <MudTh>Datum</MudTh>
            <MudTh Style="text-align:right">Durchschnitt</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.SubjectName</MudTd>
            <MudTd>@context.Date.ToString("dd.MM.yyyy")</MudTd>
            <MudTd Style="text-align:right">
                <MudChip T="string" Color="Color.Info" Size="Size.Small">2.0</MudChip>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<TestDto> tests = new();
    private List<SubjectDto> subjects = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() {
        try {
            // FEHLERBEHEBUNG: Nur DTOs nutzen
            tests = await Http.GetFromJsonAsync<List<TestDto>>("api/tests/my-tests") ?? new();
            subjects = await Http.GetFromJsonAsync<List<SubjectDto>>("api/subjects") ?? new();
        } catch (Exception ex) {
            Snackbar.Add("Fehler beim Laden", Severity.Error);
        }
    }

    private async Task OpenCreateDialog() {
        var parameters = new DialogParameters { ["Model"] = new CreateTestRequest(), ["Subjects"] = subjects };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<CreateTestDialog>("", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateTestRequest req) {
            var res = await Http.PostAsJsonAsync("api/tests", req);
            if (res.IsSuccessStatusCode) await LoadData();
        }
    }
}
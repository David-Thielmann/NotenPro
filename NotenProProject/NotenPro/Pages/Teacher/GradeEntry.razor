@page "/teacher/grades"
@page "/teacher/gradeentry"
@page "/teacher/grades/{TestId}"

@using Microsoft.AspNetCore.Authorization
@using NotenPro.Shared.DTOs
@using HTLKrems.GradeManagement.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ITestService TestService
@inject IGradeService GradeService
@inject IUserService UserService
@inject ISnackbar Snackbar

<PageTitle>Noten eintragen</PageTitle>

@if (loading)
{
    <div class="d-flex justify-center align-center" style="min-height: 400px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (string.IsNullOrWhiteSpace(TestId))
{
    <MudCard Elevation="2" Class="mb-4">
        <MudCardHeader>
            <MudText Typo="Typo.h6">Test auswählen</MudText>
        </MudCardHeader>
        <MudCardContent>
            @if (tests.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Keine Tests gefunden.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@tests" Dense="true" Hover="true" Bordered="false">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Fach</MudTh>
                        <MudTh>Klasse</MudTh>
                        <MudTh>Datum</MudTh>
                        <MudTh>Typ</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Fach">@context.Subject</MudTd>
                        <MudTd DataLabel="Klasse">@context.ClassName</MudTd>
                        <MudTd DataLabel="Datum">@context.Date.ToString("dd.MM.yyyy")</MudTd>
                        <MudTd DataLabel="Typ">@context.Type</MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => Nav.NavigateTo($"/teacher/grades/{context.Id}"))">
                                Noten
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCardContent>
    </MudCard>
}
else if (test == null)
{
    <MudAlert Severity="Severity.Error">Test nicht gefunden</MudAlert>
}
else
{
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" Class="mb-2">@test.Name</MudText>
                    <div class="d-flex gap-4 flex-wrap">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Fach</MudText>
                            <MudText>@test.Subject</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Max. Punkte</MudText>
                            <MudText>@test.MaxPoints</MudText>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center justify-end">
                    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                               Variant="Variant.Outlined"
                               OnClick="@GoBack">
                        Zurück
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Notenerfassung</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton StartIcon="@Icons.Material.Filled.Save"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SaveAllGrades"
                           Disabled="saving">
                    @if (saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                    else { <span>Alle speichern</span> }
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudTable Items="@studentGrades" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Schüler</MudTh>
                    <MudTh>Punkte</MudTh>
                    <MudTh>Note</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div>
                            <MudText Typo="Typo.body2">
                                @(studentNames.TryGetValue(context.StudentId, out var name) ? name : "Unbekannt")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @context.StudentId
                            </MudText>
                        </div>
                    </MudTd>
                    <MudTd>
                        <MudNumericField @bind-Value="context.Points" Min="0" Max="@test.MaxPoints" Variant="Variant.Outlined" Dense="true" />
                    </MudTd>
                    <MudTd>
                        <MudNumericField @bind-Value="context.GradeValue" Min="1" Max="5" Variant="Variant.Outlined" Dense="true" />
                    </MudTd>
                    <MudTd>
                        <MudSelect T="GradeStatus" @bind-Value="context.Status" Variant="Variant.Outlined" Dense="true">
                            <MudSelectItem T="GradeStatus" Value="@GradeStatus.Graded">Benotet</MudSelectItem>
                            <MudSelectItem T="GradeStatus" Value="@GradeStatus.Pending">Ausstehend</MudSelectItem>
                            <MudSelectItem T="GradeStatus" Value="@GradeStatus.Absent">Abwesend</MudSelectItem>
                        </MudSelect>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public string TestId { get; set; } = string.Empty;

    private Test? test;
    private List<Grade> studentGrades = new();

    private List<Test> tests = new();
    private string? classIdFilter;

    private bool loading = true;
    private bool saving = false;

    private Dictionary<string, string> studentNames = new();

    protected override async Task OnParametersSetAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(TestId))
            {
                test = null;
                studentGrades = new();
                studentNames = new();

                var query = ParseQueryParams(Nav.Uri);
                classIdFilter = query.TryGetValue("classId", out var cid) ? cid : null;

                var allTestsForList = await TestService.GetMyTestsAsync() ?? new List<Test>();
                tests = allTestsForList
                    .Where(t => string.IsNullOrWhiteSpace(classIdFilter) || t.ClassId == classIdFilter)
                    .OrderByDescending(t => t.Date)
                    .ToList();

                return;
            }

            var allTestsForSingle = await TestService.GetMyTestsAsync() ?? new List<Test>();
            test = allTestsForSingle.FirstOrDefault(t => t.Id == TestId);

            if (test != null)
            {
                var existing = await GradeService.GetGradesByTestAsync(TestId) ?? new();

                var students = string.IsNullOrWhiteSpace(test.ClassId)
                    ? new List<UserDto>()
                    : await UserService.GetStudentsByClassAsync(test.ClassId) ?? new();

                // Name-Mapping: StudentId -> "Vorname Nachname"
                studentNames = students.ToDictionary(
                    s => s.Id,
                    s => $"{s.Name}"
                );

                var merged = new List<Grade>();

                foreach (var s in students)
                {
                    var g = existing.FirstOrDefault(x => x.StudentId == s.Id);

                    if (g == null)
                    {
                        g = new Grade
                        {
                            StudentId = s.Id,
                            TestId = test.Id,
                            TestName = test.Name,
                            Subject = test.Subject,
                            MaxPoints = test.MaxPoints,
                            Date = test.Date,
                            Status = GradeStatus.Pending
                        };
                    }
                    else
                    {
                        g.TestId = test.Id;
                        g.TestName = test.Name;
                        g.Subject = test.Subject;
                        g.MaxPoints = test.MaxPoints;
                        g.Date = test.Date;
                    }

                    merged.Add(g);
                }

                foreach (var g in existing)
                {
                    if (merged.All(x => x.StudentId != g.StudentId))
                        merged.Add(g);
                }

                // Optional: sortiert nach Name (sonst nach Id)
                studentGrades = merged
                    .OrderBy(g => studentNames.TryGetValue(g.StudentId, out var n) ? n : g.StudentId)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAllGrades()
    {
        if (test == null) return;
        saving = true;

        try
        {
            var result = await GradeService.SaveGradesBulkAsync(studentGrades);
            if (result.Success) Snackbar.Add("Gespeichert", Severity.Success);
            else Snackbar.Add(result.Message, Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private void GoBack()
    {
        if (test != null && !string.IsNullOrWhiteSpace(test.ClassId))
        {
            Nav.NavigateTo($"/teacher/grades?classId={Uri.EscapeDataString(test.ClassId)}");
            return;
        }

        Nav.NavigateTo("/teacher/grades");
    }

    private static Dictionary<string, string> ParseQueryParams(string absoluteOrRelativeUri)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        Uri uri;
        if (Uri.TryCreate(absoluteOrRelativeUri, UriKind.Absolute, out var abs))
            uri = abs;
        else
            uri = new Uri("http://local" + absoluteOrRelativeUri);

        var q = uri.Query;
        if (string.IsNullOrWhiteSpace(q)) return dict;

        var raw = q.TrimStart('?');
        var parts = raw.Split('&', StringSplitOptions.RemoveEmptyEntries);

        foreach (var part in parts)
        {
            var kv = part.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0].Replace('+', ' '));
            var val = kv.Length > 1 ? Uri.UnescapeDataString(kv[1].Replace('+', ' ')) : string.Empty;

            if (!string.IsNullOrWhiteSpace(key))
                dict[key] = val;
        }

        return dict;
    }
}

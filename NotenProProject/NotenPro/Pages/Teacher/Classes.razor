@page "/teacher/classes"
@using Microsoft.AspNetCore.Authorization
@using NotenPro.Shared.DTOs
@using HTLKrems.GradeManagement.Models @* Wichtig für die 'Class' & 'Grade' Models *@
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IClassService ClassService
@inject IUserService UserService
@inject ISnackbar Snackbar

<PageTitle>Meine Klassen</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Meine Klassen</MudText>

@if (loading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else
{
    <MudGrid>
        @if (!myClasses.Any())
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                    Sie sind derzeit keinen Klassen zugeordnet.
                </MudAlert>
            </MudItem>
        }
        else
        {
            @foreach (var classInfo in myClasses)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Elevation="2" Class="hover-card">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h5">@classInfo.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @* Laut deinem DTO heißt es TeacherName *@
                                    Lehrer: @(string.IsNullOrEmpty(classInfo.TeacherName) ? "Nicht zugewiesen" : classInfo.TeacherName)
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudGrid>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Schüler</MudText>
                                    <MudText Typo="Typo.h6">@classInfo.StudentCount</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Ø Note</MudText>
                                    <MudText Typo="Typo.h6">@classInfo.AverageGrade.ToString("F2")</MudText>
                                </MudItem>
                            </MudGrid>

                            @if (expandedClassId == classInfo.Id)
                            {
                                <MudDivider Class="my-4"/>

                                @if (loadingDetails)
                                {
                                    <div class="d-flex justify-center py-4">
                                        <MudProgressCircular Color="Color.Secondary" Size="Size.Small" Indeterminate="true" />
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">Schülerliste</MudText>
                                    <MudTable Items="@classStudents" Dense="true" Hover="true" Elevation="0" Context="studentContext">
                                        <HeaderContent>
                                            <MudTh>Name</MudTh>
                                            <MudTh>Status</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd>@studentContext.Name</MudTd>
                                            <MudTd>
                                                <MudChip T="string" Size="Size.Small" 
                                                         Color="@(studentContext.IsActive ? Color.Success : Color.Error)" 
                                                         Variant="Variant.Text">
                                                    @(studentContext.IsActive ? "Aktiv" : "Inaktiv")
                                                </MudChip>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               Class="mt-4"
                                               OnClick="@(() => Nav.NavigateTo($"/teacher/grades?classId={classInfo.Id}"))">
                                        ZUR NOTENEINTRAGUNG
                                    </MudButton>
                                }
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       OnClick="@(() => ToggleClassDetails(classInfo.Id))">
                                @(expandedClassId == classInfo.Id ? "Details ausblenden" : "Schüler anzeigen")
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
}

@code {
    // FIX: Wir nutzen ClassDto für die Liste, da dein ClassService das liefert
    private List<Class> myClasses = new(); 
    
    // FIX: Wir nutzen UserDto für die Schülerliste
    private List<UserDto> classStudents = new();
    
    private bool loading = true;
    private bool loadingDetails = false;
    private string? expandedClassId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!auth.User.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            // Holt die Daten vom Service (als ClassDto)
            myClasses = await ClassService.GetClassesAsync() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klassen konnten nicht geladen werden.", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleClassDetails(string classId)
    {
        if (expandedClassId == classId)
        {
            expandedClassId = null;
            classStudents.Clear();
            return;
        }

        expandedClassId = classId;
        loadingDetails = true;
        
        try
        {
            // Holt Schüler als UserDto
            classStudents = await UserService.GetStudentsByClassAsync(classId) ?? new();
        }
        catch (Exception)
        {
            Snackbar.Add("Fehler beim Laden der Schülerliste.", Severity.Error);
        }
        finally
        {
            loadingDetails = false;
        }
    }
}
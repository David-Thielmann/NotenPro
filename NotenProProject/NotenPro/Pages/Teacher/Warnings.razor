@page "/teacher/warnings"
@using Microsoft.AspNetCore.Authorization
@using NotenPro.Shared.DTOs
@using HTLKrems.GradeManagement.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IGradeService GradeService
@inject IClassService ClassService
@inject ISnackbar Snackbar

<PageTitle>Frühwarnungen</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <MudText Typo="Typo.h4" Style="font-weight: 600;">Frühwarnungen</MudText>
</div>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    Schüler mit einem Notendurchschnitt von **über 3,5** (Richtung 5) werden hier vorgeschlagen.
</MudAlert>

<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudSelect T="string" Label="Klasse filtern" @bind-Value="selectedClassId" Variant="Variant.Outlined">
            <MudSelectItem T="string" Value="@("")">Alle Klassen</MudSelectItem>
            @foreach (var cls in classes)
            {
                <MudSelectItem T="string" Value="@cls.Id">@cls.Name</MudSelectItem>
            }
        </MudSelect>
    </MudCardContent>
</MudCard>

<MudCard Elevation="2">
    <MudCardContent>
        @if (loading)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!FilteredStudentsAtRisk.Any())
        {
            <MudAlert Severity="Severity.Success">Keine gefährdeten Schüler gefunden.</MudAlert>
        }
        else
        {
            <MudTable Items="@FilteredStudentsAtRisk" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Schüler ID</MudTh>
                    <MudTh>Durchschnitt</MudTh>
                    <MudTh>Noten</MudTh>
                    <MudTh>Aktion</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.StudentId</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@GetAverageColor(context.Average)">
                            @context.Average.ToString("F2")
                        </MudChip>
                    </MudTd>
                    <MudTd>@context.GradeCount</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                   OnClick="@(() => OpenWarningDialog(context))">
                            Warnung senden
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

<MudDialog @bind-Visible="showWarningDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent><MudText Typo="Typo.h6">Frühwarnung senden</MudText></TitleContent>
    <DialogContent>
        @if (selectedStudent != null)
        {
            <MudText>Sende Warnung für Student <b>@selectedStudent.StudentId</b></MudText>
            <MudTextField @bind-Value="warningComment" Label="Grund" Lines="3" Variant="Variant.Outlined" Class="mt-4" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => showWarningDialog = false">Abbrechen</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="SendWarning">Senden</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Class> classes = new();
    private List<StudentAtRisk> studentsAtRisk = new();
    private string selectedClassId = "";
    private bool loading = true;
    private bool showWarningDialog = false;
    private StudentAtRisk? selectedStudent;
    private string warningComment = "";

    // Hilfsklasse direkt hier definieren, um "Cannot resolve symbol" zu fixen
    public class StudentAtRisk {
        public string StudentId { get; set; } = "";
        public string ClassId { get; set; } = "";
        public decimal Average { get; set; }
        public int GradeCount { get; set; }
    }

    private IEnumerable<StudentAtRisk> FilteredStudentsAtRisk => 
        string.IsNullOrEmpty(selectedClassId) ? studentsAtRisk : studentsAtRisk.Where(s => s.ClassId == selectedClassId);

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true;
        try {
            classes = await ClassService.GetClassesAsync() ?? new();
            // Wir holen alle Noten. Da Grade kein StudentName hat, arbeiten wir nur mit IDs
            var allGrades = await GradeService.GetGradesByTestAsync("") ?? new(); 
            
            studentsAtRisk = allGrades
                .GroupBy(g => g.StudentId)
                .Select(group => new StudentAtRisk {
                    StudentId = group.Key,
                    Average = group.Average(x => (decimal)x.GradeValue),
                    GradeCount = group.Count(),
                    ClassId = classes.FirstOrDefault()?.Id ?? "" // Vereinfachte Zuordnung
                })
                .Where(s => s.Average >= 3.5m)
                .ToList();
        } catch { Snackbar.Add("Fehler beim Laden", Severity.Error); }
        finally { loading = false; }
    }

    private void OpenWarningDialog(StudentAtRisk student) {
        selectedStudent = student;
        warningComment = "";
        showWarningDialog = true;
    }

    private async Task SendWarning() {
        Snackbar.Add("Warnung wurde simuliert gesendet", Severity.Success);
        showWarningDialog = false;
    }

    private Color GetAverageColor(decimal average) => average >= 4.5m ? Color.Error : (average >= 3.8m ? Color.Warning : Color.Info);
}
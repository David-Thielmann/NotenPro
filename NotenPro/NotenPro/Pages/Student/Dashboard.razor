@page "/student/dashboard"
@inject IStudentService StudentService
@inject IGradeService GradeService
@inject INotificationService NotificationService

<PageTitle>Dashboard - Schüler</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Dashboard</MudText>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <!-- Statistics Cards -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="hover-card">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Notendurchschnitt
                            </MudText>
                            <MudText Typo="Typo.h4">@stats.AverageGrade.ToString("F1")</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="hover-card">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Unbenotete Tests
                            </MudText>
                            <MudText Typo="Typo.h4">@stats.UngradedTests</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Size="Size.Large" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="hover-card">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Benachrichtigungen
                            </MudText>
                            <MudText Typo="Typo.h4">@stats.UnreadNotifications</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Notifications" Color="Color.Info" Size="Size.Large" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="hover-card">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Klasse
                            </MudText>
                            <MudText Typo="Typo.h4">@stats.ClassName</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Success" Size="Size.Large" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Recent Grades -->
    <MudCard Elevation="2" Class="mb-6">
        <MudCardHeader>
            <MudText Typo="Typo.h6">Letzte Noten</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudTable Items="@recentGrades" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Fach</MudTh>
                    <MudTh>Test</MudTh>
                    <MudTh>Note</MudTh>
                    <MudTh>Datum</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Fach">@context.Subject</MudTd>
                    <MudTd DataLabel="Test">@context.TestName</MudTd>
                    <MudTd DataLabel="Note">
                        <MudChip T="decimal" Color="@GetGradeColor(context.GradeValue)" Size="Size.Small">
                            @context.GradeValue
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Datum">@context.Date.ToString("dd.MM.yyyy")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>

    <!-- Subject Overview -->
    <MudCard Elevation="2">
        <MudCardHeader>
            <MudText Typo="Typo.h6">Fächer-Übersicht</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                @foreach (var subject in subjectAverages)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.body1">@subject.Name</MudText>
                                    <MudChip T="decimal" Color="@GetGradeColor(subject.Average)" Size="Size.Small">
                                        @subject.Average.ToString("F1")
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @subject.TestCount Test(s)
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

@code {
    private bool isLoading = true;
    private Services.StudentDashboardStats stats = new();
    private List<Grade> recentGrades = new();
    private List<Services.SubjectAverage> subjectAverages = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        stats = await StudentService.GetDashboardStatsAsync();
        recentGrades = await GradeService.GetRecentGradesAsync(5);
        subjectAverages = await GradeService.GetSubjectAveragesAsync();
        isLoading = false;
    }

    private Color GetGradeColor(decimal grade)
    {
        return grade <= 2.0m ? Color.Success : grade <= 3.5m ? Color.Warning : Color.Error;
    }

    public class StudentDashboardStats
    {
        public decimal AverageGrade { get; set; } = 2.1m;
        public int UngradedTests { get; set; } = 3;
        public int UnreadNotifications { get; set; } = 5;
        public string ClassName { get; set; } = "3AHIF";
    }

    public class SubjectAverage
    {
        public string Name { get; set; } = "";
        public decimal Average { get; set; }
        public int TestCount { get; set; }
    }
}
